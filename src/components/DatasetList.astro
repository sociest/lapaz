---
import DatasetCard from './DatasetCard.astro';
import type { DatasetNode, CategoryGroup } from '../lib/catalog';

interface Props {
  datasets: DatasetNode[];
  categories: CategoryGroup[];
  title?: string;
  subtitle?: string;
}

const {
  datasets,
  categories,
  title = "Mosaico General de Series y Datasets",
  subtitle = "Explora la totalidad de los datos paceños con visualizaciones previas integradas fila por fila."
} = Astro.props;

const totalDatasets = datasets.length;
---

<section id="catalogo-mosaico" class="dataset-catalog-section">
  <!-- Cabecera del Listado / Mosaico -->
  <div class="mosaic-section-header">
    <div>
      <h2 class="mosaic-section-title" data-i18n="datasets.title">
        {title}
      </h2>
      <p class="mosaic-section-sub">
        {subtitle}
      </p>
    </div>
    <div class="mosaic-counter-badge">
      Mostrando <strong id="visible-count" style="color: var(--color-primary);">{totalDatasets}</strong> de {totalDatasets} datasets
    </div>
  </div>

  <!-- Barra de Herramientas: Filtros Multiselección y Alternador Vista -->
  <div class="datasets-toolbar">
    <div class="datasets-filters-left">
      <span class="filters-domain-label" data-i18n="datasets.filter_by_domain">Dominios:</span>
      <div class="domain-filters" id="category-filters" role="group" aria-label="Filtro de dominios">
        <button type="button" class="filter-btn active" data-category="all" aria-pressed="true">
          <span data-i18n="search.all">Todos</span>
          <span class="filter-count">({totalDatasets})</span>
        </button>
        {categories.map((cat) => (
          <button type="button" class="filter-btn" data-category={cat.name} aria-pressed="false">
            <span>{cat.name}</span>
            <span class="filter-count">({cat.datasets.length})</span>
          </button>
        ))}
      </div>
    </div>

    <div class="datasets-view-right">
      <div class="view-toggle-group" role="group" aria-label="Modo de visualización">
        <button type="button" id="view-grid-btn" class="view-toggle-btn active" aria-pressed="true" title="Vista en Mosaico de Gráficos">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="7" height="7" x="3" y="3" rx="1"/>
            <rect width="7" height="7" x="14" y="3" rx="1"/>
            <rect width="7" height="7" x="14" y="14" rx="1"/>
            <rect width="7" height="7" x="3" y="14" rx="1"/>
          </svg>
        </button>
        <button type="button" id="view-list-btn" class="view-toggle-btn" aria-pressed="false" title="Vista en Lista">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="8" x2="21" y1="6" y2="6"/>
            <line x1="8" x2="21" y1="12" y2="12"/>
            <line x1="8" x2="21" y1="18" y2="18"/>
            <line x1="3" x2="3.01" y1="6" y2="6"/>
            <line x1="3" x2="3.01" y1="12" y2="12"/>
            <line x1="3" x2="3.01" y1="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Contenedor del Mosaico de Datasets -->
  <div class="dataset-container dataset-grid" id="dataset-container">
    {datasets.map((dataset) => (
      <div 
        class="dataset-item" 
        data-title={dataset.title.toLowerCase()}
        data-desc={dataset.description.toLowerCase()}
        data-category={dataset.category}
        data-slug={dataset.slug}
      >
        <DatasetCard dataset={dataset} />
      </div>
    ))}
  </div>

  <!-- Mensaje de Búsqueda Vacía -->
  <div id="no-results" style="display: none; text-align: center; padding: 3rem 0; color: var(--color-text-muted);">
    <p style="font-size: 1.1rem; margin-bottom: 0.5rem;" data-i18n="search.no_results">No se encontraron datasets para esta búsqueda.</p>
    <button id="reset-search" class="btn btn-secondary btn-sm" data-i18n="search.reset">Limpiar filtros</button>
  </div>
</section>

<style>
  .dataset-catalog-section {
    margin-bottom: 4rem;
  }

  .mosaic-section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .mosaic-section-title {
    margin: 0;
    font-size: 1.65rem;
  }

  .mosaic-section-sub {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-top: 0.25rem;
  }

  .mosaic-counter-badge {
    font-family: var(--font-mono);
    font-size: 0.825rem;
    color: var(--color-text-muted);
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('dataset-search');
    const items = Array.from(document.querySelectorAll('.dataset-item'));
    const filterBtns = Array.from(document.querySelectorAll('.filter-btn'));
    const noResults = document.getElementById('no-results');
    const resetBtn = document.getElementById('reset-search');
    const datasetContainer = document.getElementById('dataset-container');
    const viewGridBtn = document.getElementById('view-grid-btn');
    const viewListBtn = document.getElementById('view-list-btn');
    const visibleCountEl = document.getElementById('visible-count');
    const heroTopicBtns = Array.from(document.querySelectorAll('.hero-topic-trigger'));

    const selectedCategories = new Set();
    const allBtn = filterBtns.find((b) => b.getAttribute('data-category') === 'all');

    function updateCategoryUI() {
      if (selectedCategories.size === 0) {
        filterBtns.forEach((b) => {
          const isAll = b.getAttribute('data-category') === 'all';
          b.classList.toggle('active', isAll);
          b.setAttribute('aria-pressed', isAll ? 'true' : 'false');
        });
      } else {
        filterBtns.forEach((b) => {
          const cat = b.getAttribute('data-category');
          const isActive = cat !== 'all' && selectedCategories.has(cat);
          b.classList.toggle('active', isActive);
          b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
        if (allBtn) {
          allBtn.classList.remove('active');
          allBtn.setAttribute('aria-pressed', 'false');
        }
      }
    }

    function filterDatasets() {
      const q = (searchInput?.value || '').trim().toLowerCase();
      let visibleCount = 0;

      items.forEach((item) => {
        const title = item.getAttribute('data-title') || '';
        const desc = item.getAttribute('data-desc') || '';
        const cat = item.getAttribute('data-category') || '';
        const slug = item.getAttribute('data-slug') || '';

        const matchesSearch = !q || title.includes(q) || desc.includes(q) || cat.toLowerCase().includes(q) || slug.includes(q);
        const matchesCategory = selectedCategories.size === 0 || selectedCategories.has(cat);

        if (matchesSearch && matchesCategory) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (visibleCountEl) visibleCountEl.textContent = visibleCount.toString();
      if (noResults) noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    // Alternar cuadrícula / lista
    function setViewMode(mode) {
      if (mode === 'list') {
        datasetContainer?.classList.add('view-list');
        datasetContainer?.classList.remove('dataset-grid');
        viewListBtn?.classList.add('active');
        viewListBtn?.setAttribute('aria-pressed', 'true');
        viewGridBtn?.classList.remove('active');
        viewGridBtn?.setAttribute('aria-pressed', 'false');
      } else {
        datasetContainer?.classList.remove('view-list');
        datasetContainer?.classList.add('dataset-grid');
        viewGridBtn?.classList.add('active');
        viewGridBtn?.setAttribute('aria-pressed', 'true');
        viewListBtn?.classList.remove('active');
        viewListBtn?.setAttribute('aria-pressed', 'false');
      }
    }

    viewGridBtn?.addEventListener('click', () => setViewMode('grid'));
    viewListBtn?.addEventListener('click', () => setViewMode('list'));

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');
        if (!cat || cat === 'all') {
          selectedCategories.clear();
        } else {
          if (selectedCategories.has(cat)) {
            selectedCategories.delete(cat);
          } else {
            selectedCategories.add(cat);
          }
        }
        updateCategoryUI();
        filterDatasets();
      });
    });

    heroTopicBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');
        if (cat) {
          selectedCategories.clear();
          selectedCategories.add(cat);
          updateCategoryUI();
          filterDatasets();
          document.getElementById('catalogo-mosaico')?.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    searchInput?.addEventListener('input', filterDatasets);

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      selectedCategories.clear();
      updateCategoryUI();
      filterDatasets();
    });

    // Leer posibles parámetros de URL
    const params = new URLSearchParams(window.location.search);
    const initialQ = params.get('q');
    const initialCat = params.get('cat');
    if (initialQ && searchInput) {
      searchInput.value = initialQ;
    }
    if (initialCat) {
      selectedCategories.add(initialCat);
      updateCategoryUI();
    }
    filterDatasets();
  });
</script>
