</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Selector de Pestañas
    const tabBtns = document.querySelectorAll('.owid-tab-btn');
    const panes = document.querySelectorAll('.owid-pane');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        tabBtns.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        panes.forEach((p) => {
          if (p.id === targetId) {
            p.style.display = 'block';
            p.classList.add('active');
          } else {
            p.style.display = 'none';
            p.classList.remove('active');
          }
        });
      });
    });

    // 2. Alternador Gráfico / Tabla
    const toggleBtns = document.querySelectorAll('.owid-toggle-btn');
    toggleBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const view = btn.getAttribute('data-view');
        toggleBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        document.querySelectorAll('.owid-pane').forEach((pane) => {
          const chartView = pane.querySelector('.owid-chart-viewport');
          const tableView = pane.querySelector('.owid-table-container');
          if (view === 'table') {
            if (chartView) chartView.style.display = 'none';
            if (tableView) tableView.style.display = 'block';
          } else {
            if (chartView) chartView.style.display = 'block';
            if (tableView) tableView.style.display = 'none';
          }
        });
      });
    });

    // 3. Hover Tooltip
    const tooltip = document.getElementById('owid-tooltip');
    const interactiveElements = document.querySelectorAll('.chart-dot, .chart-bar');

    interactiveElements.forEach((el) => {
      el.addEventListener('mouseenter', (e) => {
        const text = el.getAttribute('data-tooltip');
        if (!text || !tooltip) return;
        tooltip.textContent = text;
        tooltip.style.display = 'block';
      });

      el.addEventListener('mousemove', (e) => {
        if (!tooltip) return;
        tooltip.style.left = e.clientX + 12 + 'px';
        tooltip.style.top = e.clientY - 28 + 'px';
      });

      el.addEventListener('mouseleave', () => {
        if (tooltip) tooltip.style.display = 'none';
      });
    });
  });
</script>
